<idea-plugin>
    <id>dev.baselinehighlighter</id>
    <name>PHPStan Baseline Highlighter</name>
    <vendor>Baseline Highlighter</vendor>
    <description><![CDATA[
        Shows PHPStan baseline entries on PHP class and method declarations, with tooltips and navigation.
        Reads explicitly selected NEON files locally without running PHPStan.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="dev.baselinehighlighter-jetbrains.xml">com.jetbrains.php</depends>
    <depends optional="true" config-file="dev.baselinehighlighter-openphp.xml">ru.openide.openphp</depends>
    <depends optional="true" config-file="dev.baselinehighlighter-mcp.xml">com.intellij.mcpServer</depends>
    <extensionPoints>
        <extensionPoint name="phpDeclarationProvider" interface="dev.baselinehighlighter.php.PhpDeclarationProvider" dynamic="true"/>
    </extensionPoints>
    <resource-bundle>messages.BaselineBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <psi.symbolReferenceProvider hostLanguage="TEXT" hostElementClass="com.intellij.psi.PsiPlainTextFile"
                                     referenceClass="dev.baselinehighlighter.phpat.PhpatRuleReference"
                                     targetClass="com.intellij.model.Symbol"
                                     implementationClass="dev.baselinehighlighter.phpat.PhpatRuleReferenceProvider"/>
        <gotoDeclarationHandler implementation="dev.baselinehighlighter.phpat.PhpatRuleDeclarationHandler" order="first"/>
        <platform.backend.documentation.linkHandler implementation="dev.baselinehighlighter.phpat.PhpatDocumentationLinkHandler"/>
        <psi.symbolReferenceProvider hostLanguage="TEXT" hostElementClass="com.intellij.psi.PsiPlainTextFile"
                                     referenceClass="dev.baselinehighlighter.editor.BaselinePathSymbolReference"
                                     targetClass="com.intellij.model.Symbol"
                                     implementationClass="dev.baselinehighlighter.editor.BaselinePathReferenceProvider"/>
        <gotoDeclarationHandler implementation="dev.baselinehighlighter.editor.BaselinePathDeclarationHandler" order="first"/>
        <platform.backend.documentation.targetProvider implementation="dev.baselinehighlighter.documentation.BaselineDocumentationTargetProvider" order="first"/>
        <postStartupActivity implementation="dev.baselinehighlighter.index.BaselineStartupActivity"/>
        <codeInsight.lineMarkerProvider language="PHP" implementationClass="dev.baselinehighlighter.editor.BaselineLineMarkerProvider"/>
        <projectConfigurable id="dev.baselinehighlighter.settings" parentId="language" displayName="PHPStan Baseline Highlighter" instance="dev.baselinehighlighter.settings.BaselineSourcesConfigurable"/>
    </extensions>
    <actions>
        <action id="BaselineHighlighter.ShowEntries" class="dev.baselinehighlighter.editor.ShowBaselineEntriesAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
